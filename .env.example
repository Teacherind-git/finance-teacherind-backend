CEO_PASSWORD=
CFO_EMAIL=
CFO_PASSWORD=
CTO_EMAIL=
CTO_PASSWORD=

CLASS_THRESHOLD=
DECREMENT_PER_MISSED=
INCREMENT_PERCENT=
